  "components": {
    "schemas": {
      "Delivery": {
        "properties": {
          "delivery_id": {
            "type": "string",
            "title": "Delivery Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "total_attempts": {
            "type": "integer",
            "title": "Total Attempts"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          },
          "next_attempt_at": {
            "type": "number",
            "title": "Next Attempt At"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "result_message_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Message Id"
          }
        },
        "type": "object",
        "required": [
          "delivery_id",
          "kind",
          "status",
          "attempts",
          "total_attempts",
          "created_at",
          "updated_at",
          "next_attempt_at",
          "last_error",
          "result_message_id"
        ],
        "title": "Delivery"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "SendBody": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          },
          "chat_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^oc_[A-Za-z0-9_-]+$",
            "title": "Chat Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "chat_id"
        ],
        "title": "SendBody"
      },
      "TextBody": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextBody"
      }
    },
    "securitySchemes": {
