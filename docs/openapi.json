  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Grant": {
        "properties": {
          "app_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "App Id"
          },
          "operations": {
            "items": {
              "type": "string",
              "enum": [
                "events.receive",
                "messages.send",
                "messages.reply",
                "status.read"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Operations"
          },
          "chat_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 128,
            "title": "Chat Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "app_id",
          "operations"
        ],
        "title": "Grant"
      },
      "SendBody": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "chat_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^oc_[A-Za-z0-9_-]+$",
            "title": "Chat Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "chat_id"
        ],
        "title": "SendBody"
      },
      "SendResult": {
        "properties": {
          "status": {
            "type": "string",
            "const": "sent",
            "title": "Status",
            "default": "sent"
          },
          "message_id": {
            "type": "string",
            "title": "Message Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id"
        ],
        "title": "SendResult"
      },
      "TextBody": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextBody"
      },
      "TokenRequest": {
        "properties": {
          "principal_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Principal Id"
          },
          "grants": {
            "items": {
              "$ref": "#/components/schemas/Grant"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Grants"
          },
          "ttl_seconds": {
            "type": "integer",
            "maximum": 604800.0,
            "minimum": 1.0,
            "title": "Ttl Seconds",
            "default": 3600
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "principal_id",
          "grants"
        ],
        "title": "TokenRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "Bearer",
            "title": "Token Type",
            "default": "Bearer"
          },
          "expires_at": {
            "type": "integer",
            "title": "Expires At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "access_token",
          "expires_at"
        ],
        "title": "TokenResponse"
