FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
WEBHOOK_URL=https://your-receiver.example/webhook/feishu
WEBHOOK_SIGNING_SECRET=replace_with_at_least_32_random_characters
API_ACCESS_TOKEN=replace_with_another_32_random_characters
# Comma-separated Feishu open_id / chat_id. Empty means unrestricted.
USER_ALLOWLIST=
CHAT_ALLOWLIST=
DATA_DIR=./data
PORT=8080
LOG_LEVEL=INFO
RETRY_MAX_ATTEMPTS=8
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15
SHUTDOWN_TIMEOUT_SECONDS=25
# Set by Docker build; do not override in Zeabur.
CODE_VERSION=dev
