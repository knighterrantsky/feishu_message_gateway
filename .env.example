FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
# Generate two independent random values (at least 32 characters each).
# The admin token issues scoped client tokens; never distribute it to regular clients.
GATEWAY_ADMIN_TOKEN=replace_with_an_independent_random_admin_token
TOKEN_SIGNING_KEY=replace_with_an_independent_random_signing_key
TOKEN_ISSUER=feishu-message-gateway
TOKEN_AUDIENCE=feishu-message-gateway-clients
TOKEN_MAX_TTL_SECONDS=86400
# Optional ingress filters. Comma-separated open_id / chat_id; empty means unrestricted.
# Outbound permissions are controlled by each client's token grants, not these lists.
USER_ALLOWLIST=
CHAT_ALLOWLIST=
PORT=8080
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=15
SHUTDOWN_TIMEOUT_SECONDS=25
MAX_CONNECTIONS=100
MAX_SUBSCRIPTIONS_PER_CONNECTION=16
MAX_MESSAGE_BYTES=65536
CONNECTION_BUFFER_MESSAGES=100
CONNECTION_BUFFER_BYTES=1048576
TOTAL_BUFFER_BYTES=33554432
WS_AUTH_TIMEOUT_SECONDS=10
WS_WRITE_TIMEOUT_SECONDS=5
MAX_OUTBOUND_REQUESTS=16
IDEMPOTENCY_CACHE_ENTRIES=10000
# Set by Docker build; do not override in Zeabur.
CODE_VERSION=dev
